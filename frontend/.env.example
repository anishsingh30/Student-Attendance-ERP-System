# ==============================================================================
# AttendanceAI Frontend Environment Configuration Template
# ==============================================================================
# In production on Vercel (Unified Deployment), this can remain blank or set to /api
# to use same-origin proxying.
#
# For local independent Vite development with local FastAPI backend:
# VITE_API_URL=http://localhost:8000/api
#
# For production separated frontend:
# VITE_API_URL=https://api.yourdomain.com/api
# ==============================================================================

VITE_API_URL=/api
