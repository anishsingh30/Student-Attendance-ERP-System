# ==========================================
# AttendanceAI Production .gitignore
# ==========================================

# ENVIRONMENT & SECRETS
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/
credentials/
service-account*.json

# PYTHON
venv/
.venv/
backend/venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
backend/.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
ENV/

# NODE & FRONTEND BUILD
node_modules/
frontend/node_modules/
dist/
frontend/dist/
build/
.vite/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
frontend/.tmp/
.eslintcache

# DATABASE & RUNTIME DATA
*.db
*.sqlite
*.sqlite3
*.db-journal
attendance.db
backend/attendance.db
test_alembic_fresh.db
backend/test_alembic_fresh.db

# LOCAL UPLOADS & RUNTIME STORAGE (preserve directory with .gitkeep)
backend/uploads/*
!backend/uploads/**/.gitkeep
uploads/*
!uploads/**/.gitkeep
media/*
tmp/
temp/

# MACHINE & IDE
.vscode/
.idea/
*.code-workspace
*.swp
*.swo

# OS GENERATED
.DS_Store
Thumbs.db
desktop.ini

# LOGS & TEMPORARY SCRIPTS
*.log
logs/
*scratch*
scratch/
recovered_alerts.txt
scan_secrets.py
fix_encoding.py

# CACHE & METRICS
.cache/
coverage/
htmlcov/
