# ==========================================
# Automated Student Attendance Alert System
# Environment Configuration Template
# ==========================================

# Core Application & Security
PROJECT_NAME="Automated Student Attendance Alert System"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local default: SQLite (zero installation required)
DATABASE_URL="sqlite:///./attendance.db"
# Production / Docker Postgres example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/attendance_ai"

# AI Engine Configuration
# Supported options: "mock" (offline fallback), "gemini", "openai"
LLM_PROVIDER="mock"
GEMINI_API_KEY="your-gemini-api-key-here"
OPENAI_API_KEY="your-openai-api-key-here"

# Default Institutional Attendance Thresholds
DEFAULT_THRESHOLD_GREEN=80.0
DEFAULT_THRESHOLD_YELLOW=75.0
DEFAULT_THRESHOLD_ORANGE=65.0

# Multi-Channel Notification Dispatch (SMTP Email)
SMTP_HOST="smtp.college.edu"
SMTP_PORT=587
SMTP_USER="alerts@college.edu"
SMTP_PASSWORD="replace-with-smtp-password"
SMTP_FROM_EMAIL="attendance-alerts@college.edu"

# Autonomous Background Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_HOURS=24

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

