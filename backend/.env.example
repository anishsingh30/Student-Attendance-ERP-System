# ==========================================
# Automated Student Attendance Alert System
# Environment Configuration (Backend)
# ==========================================

PROJECT_NAME="Automated Student Attendance Alert System"
ENVIRONMENT="development"
SECRET_KEY="REPLACE_WITH_A_SECURE_RANDOM_SECRET"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration:
# SQLite (Local zero-install default):
DATABASE_URL="sqlite:///./attendance.db"
# PostgreSQL (Production / Docker):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/attendance_ai"

# AI / LLM Engine ("mock", "gemini", or "openai")
LLM_PROVIDER="gemini"
GEMINI_API_KEY="REPLACE_WITH_YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"
OPENAI_API_KEY=""

# University Institutional Attendance Thresholds (%)
DEFAULT_THRESHOLD_GREEN=80.0
DEFAULT_THRESHOLD_YELLOW=75.0
DEFAULT_THRESHOLD_ORANGE=65.0

# CORS & Web Security
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000"
SECURITY_HEADERS_ENABLED=true

# Rate Limiting
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_REQUESTS=15
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
